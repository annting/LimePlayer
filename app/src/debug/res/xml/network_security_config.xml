<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建生效（见 src/debug/AndroidManifest.xml）。
  允许明文流量并信任用户安装的证书，方便：
  · 连局域网内的 Emby / 飞牛影视（HTTP）
  · 用抓包工具看接口（M0 任务 0-1 ~ 0-6）
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
