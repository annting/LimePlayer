<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图 Logo（矢量）：288x288dp 画布，核心图形占中央 192x192dp
  对应设计稿 design/assets/limeplayer-splash.jpg 中的绿色播放按钮
  用于 windowSplashScreenAnimatedIcon（Android 12+ 系统启动画面）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- 外圈辉光 -->
    <path
        android:pathData="M144,144m-144,0a144,144 0 1,0 288,0a144,144 0 1,0 -288,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="144"
                android:centerY="144"
                android:gradientRadius="144">
                <item android:offset="0" android:color="#7569C72B" />
                <item android:offset="0.62" android:color="#2B69C72B" />
                <item android:offset="1" android:color="#0069C72B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 按钮圆面 -->
    <path
        android:pathData="M144,144m-96,0a96,96 0 1,0 192,0a96,96 0 1,0 -192,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="96"
                android:startY="48"
                android:endX="192"
                android:endY="240">
                <item android:offset="0" android:color="#FF74D22F" />
                <item android:offset="1" android:color="#FF60BA26" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 播放三角（圆角） -->
    <path
        android:pathData="M123.5,111.5 L181,143 L123.5,174.5 Z"
        android:fillColor="#FF9CFF32"
        android:strokeColor="#FF9CFF32"
        android:strokeWidth="9"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
</vector>
