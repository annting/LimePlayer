  release 构建不包含本文件，保持 docs/02-技术规范.md §8 的「默认关闭」安全基线。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
